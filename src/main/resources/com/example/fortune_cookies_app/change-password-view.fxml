<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<Pane prefHeight="300.0" prefWidth="400.0" stylesheets="@GUI.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label layoutX="63.0" layoutY="68.0" prefHeight="0.0" prefWidth="210.0" text="New Password">

      </Label>
      <PasswordField fx:id="changePassword" layoutX="63.0" layoutY="92.0" prefHeight="0.0" prefWidth="275.0" promptText="Password" style="-fx-border-width: 2; -fx-border-radius: 5; -fx-border-color: black;">
         </PasswordField>
      <Label layoutX="63.0" layoutY="135.0" prefHeight="0.0" prefWidth="210.0" text="Confirm Password">
      </Label>
      <PasswordField fx:id="confirmChangePassword" layoutX="63.0" layoutY="155.0" prefHeight="0.0" prefWidth="275.0" promptText="Confirm Password" style="-fx-border-width: 2; -fx-border-radius: 5; -fx-border-color: black;">
         </PasswordField>
      <Button fx:id="confirmChangePassword" layoutX="112.0" layoutY="203.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="177.0" text="CONFIRM" />
      <Button layoutX="330.0" layoutY="14.0" mnemonicParsing="false" text="CLOSE" />
      <Button layoutX="112.0" layoutY="240.0" mnemonicParsing="false" prefHeight="29.0" prefWidth="177.0" text="BACK" />
   </children>
</Pane>
