<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="543.0" prefWidth="330.0" spacing="15" stylesheets="@GUI.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.fortune_cookies_app.controller.DefaultSidebarController">
        <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
        </padding>

    <Pane prefHeight="377.0" prefWidth="290.0" VBox.vgrow="ALWAYS">
        <ScrollPane fitToHeight="true" fitToWidth="true" layoutX="6.0" layoutY="350.0" pannable="true"
                    prefHeight="150.0" prefWidth="277.0" VBox.vgrow="ALWAYS">
            <VBox fx:id="eventsList" prefHeight="176.0" prefWidth="275.0" spacing="10"/>
        </ScrollPane>
        <Pane prefHeight="340.0" prefWidth="290.0" VBox.vgrow="ALWAYS">
            <Label layoutX="101.0" layoutY="5.0" text="DAILY MESSAGE">
                <font>
                    <Font name="Lucida Sans Unicode" size="12.0"/>
                </font>
            </Label>
            <TextArea fx:id="aiDailyMessage" editable="false" layoutX="6.0" layoutY="31.0" prefHeight="83.0"
                      prefRowCount="6" prefWidth="277.0" promptText="Your daily event message will appear here."
                      wrapText="true"/>
            <Button fx:id="saveMessage" layoutX="97.0" layoutY="127.0" mnemonicParsing="false"
                    onAction="#onSaveMessageClick" prefHeight="29.0" prefWidth="100.0" stylesheets="@GUI.css"
                    text="Save Message"/>
            <Label layoutX="111.0" layoutY="170.0" text="STUDY TIPS">
                <font>
                    <Font name="Lucida Sans Unicode" size="12.0"/>
                </font>
            </Label>
            <TextArea editable="false" layoutX="5.0" layoutY="202.0" prefHeight="128.0" prefWidth="278.0"
                      promptText="Your study tips will appear here." wrapText="true"/>
            <Separator layoutX="56.0" layoutY="339.0" prefWidth="200.0"/>
        </Pane>
    </Pane>
</VBox>
