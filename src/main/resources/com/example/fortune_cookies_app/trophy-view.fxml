<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane style="-fx-background-color: #2C2C2C;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.fortune_cookies_app.controller.TrophyController">

   <VBox alignment="CENTER" spacing="20">
      <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" text="TROPHIES">
         <font>
            <Font name="Lucida Sans Unicode" size="12.0" />
         </font></Label>

      <GridPane fx:id="trophyGrid" alignment="CENTER" hgap="20" vgap="20">
         <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
         </padding>
      </GridPane>
   </VBox>
</StackPane>
