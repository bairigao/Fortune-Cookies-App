<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" fillWidth="false" prefHeight="720.0" prefWidth="1280.0" spacing="15.0" stylesheets="@LOGIN_GUI.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.fortune_cookies_app.controller.PasswordController">

    <Label alignment="CENTER" prefHeight="178.0" prefWidth="383.0" text="RESET">
        <font>
            <Font name="Fira Code Bold" size="96.0" />
        </font>
    </Label>

    <!-- STEP 1: Enter Email -->
    <VBox fx:id="step1Pane" alignment="CENTER" prefWidth="275.0" spacing="10.0">
        <Label text="Enter Your Email">
            <font>
                <Font name="Lucida Sans Unicode" size="16.0" />
            </font>
        </Label>
        <TextField fx:id="emailField" prefWidth="275.0" promptText="Email" style="-fx-border-width: 2; -fx-border-radius: 5; -fx-border-color: grey;">
            <font>
                <Font size="14.0" />
            </font>
        </TextField>

        <Button onAction="#onEmailSubmit" prefHeight="16.0" prefWidth="103.0" style="-fx-border-radius: 5; -fx-background-color: lightgrey; -fx-border-color: grey; -fx-border-width: 2;" text="NEXT" />
        <Button onAction="#onBackClick" prefHeight="16.0" prefWidth="103.0" style="-fx-border-radius: 5; -fx-background-color: lightgrey; -fx-border-color: grey; -fx-border-width: 2;" text="BACK" />

    </VBox>

    <!-- STEP 2: Security Question -->
    <VBox fx:id="step2Pane" alignment="CENTER" managed="false" prefWidth="275.0" spacing="10.0" visible="false">
        <Label fx:id="securityQuestionLabel" wrapText="true">
            <font>
                <Font name="Lucida Sans Unicode" size="16.0" />
            </font>
        </Label>
        <TextField fx:id="securityAnswerField" prefWidth="275.0" promptText="Your Answer" style="-fx-border-width: 2; -fx-border-radius: 5; -fx-border-color: black;">
            <font>
                <Font size="14.0" />
            </font>
        </TextField>

        <Button onAction="#onSecurityAnswerSubmit" prefHeight="16.0" prefWidth="103.0" style="-fx-border-radius: 5; -fx-background-color: lightgrey; -fx-border-color: grey; -fx-border-width: 2;" text="NEXT" />
        <Button onAction="#onBackClick" prefHeight="16.0" prefWidth="103.0" style="-fx-border-radius: 5; -fx-background-color: lightgrey; -fx-border-color: grey; -fx-border-width: 2;" text="BACK" />

    </VBox>

    <!-- STEP 3: Change Password -->
    <VBox fx:id="step3Pane" alignment="CENTER" managed="false" prefWidth="275.0" spacing="10.0" visible="false">
        <Label text="Enter New Password">
            <font>
                <Font name="Lucida Sans Unicode" size="16.0" />
            </font>
        </Label>
        <PasswordField fx:id="newPasswordField" prefWidth="275.0" promptText="New Password" style="-fx-border-width: 2; -fx-border-radius: 5; -fx-border-color: black;">
            <font>
                <Font size="14.0" />
            </font>
        </PasswordField>

        <PasswordField fx:id="confirmPasswordField" prefWidth="275.0" promptText="Confirm Password" style="-fx-border-width: 2; -fx-border-radius: 5; -fx-border-color: black;">
            <font>
                <Font size="14.0" />
            </font>
        </PasswordField>

        <Button onAction="#onPasswordChangeSubmit" prefHeight="16.0" prefWidth="150.0" style="-fx-border-radius: 5; -fx-background-color: lightgrey; -fx-border-color: grey; -fx-border-width: 2;" text="CONFIRM" />
        <Button onAction="#onBackClick" prefHeight="16.0" prefWidth="103.0" style="-fx-border-radius: 5; -fx-background-color: lightgrey; -fx-border-color: grey; -fx-border-width: 2;" text="BACK" />

    </VBox>

    <!-- General Feedback -->
    <Label fx:id="feedbackLabel" maxWidth="300" textFill="red" visible="false" wrapText="true" />

</VBox>
