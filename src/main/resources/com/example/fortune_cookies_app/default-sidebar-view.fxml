                <Font name="System Bold" size="12.0" />
            </font>
            </Label>
            <TextArea fx:id="aiDailyMessage" editable="false" layoutX="6.0" layoutY="4.0" prefHeight="83.0" prefRowCount="6" prefWidth="277.0" promptText="Your daily event message will appear here." wrapText="true" />
            <Button fx:id="saveMessage" layoutX="97.0" layoutY="93.0" mnemonicParsing="false" onAction="#onSaveMessageClick" prefHeight="29.0" prefWidth="100.0" stylesheets="@GUI.css" text="Save Message" />
            <Label layoutX="111.0" layoutY="147.0" text="STUDY TIPS">
                <font>
                    <Font name="System Bold" size="12.0" />
                </font>
            </Label>
            <TextArea fx:id="aiStudyTips" editable="false" layoutX="5.0" layoutY="168.0" prefHeight="201.0" prefWidth="278.0" promptText="Your study tips will appear here." wrapText="true" />
            <Separator layoutX="46.0" layoutY="381.0" prefWidth="200.0" />
         <ImageView fitHeight="18.0" fitWidth="22.0" layoutX="79.0" layoutY="-17.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@../../../images/star.png" />
            </image></ImageView>
            <ImageView fitHeight="18.0" fitWidth="22.0" layoutX="42.0" layoutY="524.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../../../images/star.png" />
                </image></ImageView>
            <ImageView fitHeight="18.0" fitWidth="22.0" layoutX="88.0" layoutY="146.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../../../images/star.png" />
                </image></ImageView>
           <ScrollPane fitToHeight="true" fitToWidth="true" layoutX="6.0" layoutY="416.0" pannable="true" prefHeight="94.0" prefWidth="277.0">
               <VBox fx:id="eventsList" prefHeight="87.0" prefWidth="275.0" spacing="10" />
           </ScrollPane>
         <Label layoutX="126.0" layoutY="391.0" text="EVENTS" textAlignment="CENTER">
            <font>
               <Font name="System Bold" size="12.0" />
            </font>
         </Label>
         <ImageView fitHeight="18.0" fitWidth="22.0" layoutX="104.0" layoutY="390.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@../../../images/star.png" />
            </image>
         </ImageView>
        </Pane>
      <Separator layoutX="46.0" layoutY="134.0" prefWidth="200.0" />
        <Separator layoutX="46.0" layoutY="516.0" prefWidth="200.0" />
      <Label fx:id="streakLabel" layoutX="65.0" layoutY="524.0" text="STREAK">
