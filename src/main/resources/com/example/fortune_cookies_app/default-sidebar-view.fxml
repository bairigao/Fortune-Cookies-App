<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="588.0" prefWidth="330.0" spacing="15" stylesheets="@GUI.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.fortune_cookies_app.controller.DefaultSidebarController">
        <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
        </padding>

    <Pane prefHeight="377.0" prefWidth="290.0" VBox.vgrow="ALWAYS">
        <Pane prefHeight="548.0" prefWidth="290.0" VBox.vgrow="ALWAYS">
            <Label layoutX="101.0" layoutY="-16.0" text="DAILY MESSAGE">
